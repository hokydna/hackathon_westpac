# Copy to .env and fill in. `.env` is git-ignored and must NEVER be committed.
#
#   cp .env.example .env
#   set -a; . ./.env; set +a        # export into the shell before running
#
# src/config.py reads os.environ ONLY -- it does not parse this file. That is
# deliberate: Setup_Instructions.md requires credentials and endpoints to live in
# environment variables, and a config module that silently loads a dotfile makes
# it impossible to tell what the scored run actually used. Export before running.
#
# Every value below is a non-secret default that is already correct for the Atom
# cluster. Only LITELLM_KEY and LANGSMITH_API_KEY are secrets, and neither is
# required for the scored path.

# --------------------------------------------------------------------------
# Model endpoints and aliases  (organizer-supplied; see Setup_Instructions.md)
# --------------------------------------------------------------------------

LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_KEY=

# Qwen3.6-35B-A3B-FP8. Planning, tool selection, tool-call generation. Frozen —
# we do not fine-tune this.
BRAIN_MODEL=agent-brain

# Our fine-tuned Nemotron, once served. VERIFIED WORKING 2026-07-31: this alias
# now answers from a separate vLLM instance (fingerprint 5a3f83cd vs the brain's
# 6bc76779). The older "nemotron-8b-finance does not exist" 404 is fixed, so
# DOMAIN_PREDICT_MODE=llm works today against base Nemotron.
# When serving the adapter, keep `--served-model-name nemotron-8b-finance`.
DOMAIN_FT_MODEL=domain-ft

# `mock` is the organizer bootstrap default and returns a deterministic stub, so
# sessions A/B/C can build with no adapter served.
#
# MUST be `llm` before official evaluation. Challenge_Brief.md § Required Model
# Roles: shipping `mock` forfeits the entire 30% fine-tuned-model-quality
# category and drags architecture credit down with it.
DOMAIN_PREDICT_MODE=mock

# Where the DOMAIN model is reached. Leave BLANK to use LITELLM_BASE_URL.
# Only set it for FINETUNE_PLAN §9's fallback — pointing Nemotron straight at a
# vLLM endpoint (e.g. http://10.0.1.11:8001/v1) when the LiteLLM alias cannot be
# repaired. The brain always keeps using LiteLLM, which is why this is separate.
DOMAIN_BASE_URL=

# --------------------------------------------------------------------------
# Data
# --------------------------------------------------------------------------

# Leave BLANK. src/config.py now resolves `data set/` automatically, including
# from inside a git worktree: `data set/` is untracked so a worktree does not
# contain it, and config follows the worktree's `.git` gitfile back to the main
# checkout. Only set this to point at a corpus somewhere else entirely.
# Tests override it to tests/fixtures/dataset/ via tests/conftest.py.
DATASET_DIR=

# --------------------------------------------------------------------------
# Evaluation
# --------------------------------------------------------------------------

# The component judge replicates the organizer protocol: one expected fact per
# call, YES/NO, temperature 0, against the same Qwen brain. Keep it pinned to
# agent-brain so our number predicts the leaderboard rather than correlating
# with it.
EVAL_JUDGE_MODEL=agent-brain

# --------------------------------------------------------------------------
# Observability -- OFF for anything scored
# --------------------------------------------------------------------------
#
# LEAVE THIS FALSE unless you are debugging locally.
#
# Challenge_Brief.md § Rules: "Use only approved local datasets and services
# during official scoring." Tracing the scored path sends hidden question text
# and AFR article content to a third-party cloud. src/agent/tracing.py degrades
# to no-op passthroughs when this is falsy, so the scored run needs no code
# change -- just leave it off.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=hackathon-dev

# Secret. Prefer exporting it in your shell over storing it here.
#
# Do NOT load this file with `set -a; . ./.env` in a command whose output you
# share — that dumps the whole environment, key included. Read it in-process
# instead, or export just the one variable.
LANGSMITH_API_KEY=

# DO NOT SET. The langsmith SDK sends this as the tenant header, and a value that
# does not match your key's actual workspace makes every READ return 403 while
# writes still succeed — which is a confusing way to lose an afternoon. Leave it
# blank and the SDK resolves the right workspace from the key.
LANGSMITH_WORKSPACE_ID=

# --------------------------------------------------------------------------
# Not used by this project
# --------------------------------------------------------------------------
#
# A langchain-basics template .env may also define LANGGRAPH_ASSISTANT_ID,
# LANGSMITH_DEPLOYMENT_NAME, EMBEDDING_MODEL_NAME, EMBEDDING_CACHE_DIR and
# MODEL_NAME. Nothing here reads any of them. MODEL_NAME=gpt-5-mini in
# particular names an external OpenAI model, which Challenge_Brief.md § Rules
# would prohibit during scoring — this agent uses only the local Qwen brain and
# local Nemotron. Safe to delete those lines.
